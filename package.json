{
  "name": "nightreviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "daemon": "bun run src/daemon/main.ts",
    "mcp": "bun run src/mcp/main.ts",
    "config:doctor": "bun run scripts/session-config-doctor.ts",
    "scheduler:demo": "bun run scripts/scheduler-offline-demo.ts",
    "nr09:smoke": "bun run scripts/nr09-live-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "test": "bun test --timeout=15000",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build",
    "bridge:preflight": "bun run scripts/bridge-spike.ts --live --preflight-only",
    "bridge:live": "bun run scripts/bridge-live-capture.ts",
    "bridge:cancel": "bun run scripts/bridge-spike.ts --live --cancel-only",
    "bridge:unavailable": "bun run scripts/bridge-spike.ts --live --connector-unavailable-only"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "typebox": "1.3.34"
  }
}

{
  "name": "nightreviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "config:doctor": "bun run scripts/session-config-doctor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
